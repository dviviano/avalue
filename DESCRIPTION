Package: avalue
Type: Package
Title: Abstention Values for Optimal Follow-Up Experimentation
Version: 0.1.0
Authors@R: c(
    person(
      given = "Aristotelis",
      family = "Epanomeritakis",
      email = "aristotle_epanomeritakis@fas.harvard.edu",
      role = c("aut", "cre", "cph")
    ),
    person(
      given = "Davide",
